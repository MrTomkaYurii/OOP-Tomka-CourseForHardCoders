{
  "name": "md-to-docx",
  "version": "1.0.0",
  "description": "Markdown lecture sections → A5 Word document",
  "main": "md-to-docx.js",
  "scripts": {
    "book": "node md-to-docx.js --all",
    "ch01": "node md-to-docx.js \"../../lectures/sections/01-*.md\" \"../../lectures/questions/01-questions.md\" -o output/chapter-01.docx",
    "labs": "node labs-to-docx.js",
    "labs:pdf": "powershell -ExecutionPolicy Bypass -File ./to-pdf-all.ps1"
  },
  "dependencies": {
    "docx": "^9.5.0"
  }
}
