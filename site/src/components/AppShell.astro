---
import { getLabs, getLectures } from "@/data/course";
import { pathWithoutBase, sitePath } from "@/utils/paths";
import ThemeToggle from "@/components/ThemeToggle.astro";
import TopBar from "@/components/TopBar.astro";
import BackToTop from "@/components/BackToTop.astro";

const labs = await getLabs();
const lectures = await getLectures();
const currentPath = pathWithoutBase(Astro.url.pathname);
const lectureGroups = lectures.reduce<Array<{ title: string; items: Array<{ href: string; number: string; title: string; active: boolean }> }>>((groups, lecture) => {
  const lastGroup = groups[groups.length - 1];
  const lecturePath = `/lectures/${lecture.slug}/`;
  const sourceItems = [
    {
      href: lecturePath,
      number: lecture.numberLabel,
      title: lecture.title.replace(/^\d+\.\d+\.\s*/, "").replace(/^Розділ\s+\d+\.\s*/, ""),
      active: currentPath === lecturePath,
    },
  ];

  if (lastGroup?.title === lecture.chapterTitle) {
    lastGroup.items.push(...sourceItems);
    return groups;
  }

  groups.push({ title: lecture.chapterTitle, items: sourceItems });
  return groups;
}, []);
---

<input class="drawer-toggle left-toggle" type="checkbox" id="course-menu-toggle" aria-hidden="true" />
<div class="app-shell">
  <div class="mobile-bar">
    <label class="icon-button" for="course-menu-toggle" aria-label="Відкрити меню курсу">
      <span></span>
      <span></span>
      <span></span>
    </label>
    <a class="mobile-brand" href={sitePath("/")}>OOP Course</a>
    <ThemeToggle />
  </div>

  <label class="drawer-backdrop" for="course-menu-toggle" aria-label="Закрити меню"></label>

  <aside class="sidebar">
    <div class="drawer-head">
      <span>Меню курсу</span>
      <label class="close-button" for="course-menu-toggle" aria-label="Закрити меню">×</label>
    </div>

    <a class="brand" href={sitePath("/")}>
      <span class="brand-mark">C#</span>
      <span>
        <strong>OOP Course</strong>
        <small>Clinic system labs</small>
      </span>
    </a>

    <nav class="nav-block" aria-label="Основна навігація">
      <a class:list={["nav-link", currentPath === "/" && "active"]} href={sitePath("/")}>Огляд курсу</a>
      <a class:list={["nav-link", currentPath.startsWith("/lectures/") && "active"]} href={sitePath("/lectures/")}>Лекції</a>
      <a class:list={["nav-link", currentPath === "/labs/" && "active"]} href={sitePath("/labs/")}>Лабораторні</a>
      <a class:list={["nav-link", currentPath === "/roadmap/" && "active"]} href={sitePath("/roadmap/")}>Карта розвитку</a>
      <a class:list={["nav-link", currentPath === "/evolution/" && "active"]} href={sitePath("/evolution/")}>Еволюція проєкту</a>
    </nav>

    <div class="nav-section">
      <p>Лекції</p>
      <div class="lecture-nav">
        {lectureGroups.map((group) => (
          <details class="lecture-nav-group" open={group.items.some((item) => item.active)}>
            <summary>
              <span>{group.title.match(/^Розділ\s+(\d+)/)?.[1]?.padStart(2, "0") ?? "00"}</span>
              <strong>{group.title.replace(/^Розділ\s+\d+\.\s*/, "")}</strong>
            </summary>
            <div class="lecture-nav-list">
              {group.items.map((item) => (
                <a class:list={["lecture-nav-link", item.active && "active"]} href={sitePath(item.href)}>
                  <span>{item.number}</span>
                  <strong>{item.title}</strong>
                </a>
              ))}
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="nav-section">
      <p>Лаби</p>
      <div class="lab-nav">
        {labs.map((lab) => (
          <a class:list={["lab-nav-link", currentPath === `/labs/${lab.slug}/` && "active"]} href={sitePath(`/labs/${lab.slug}/`)}>
            <span>{String(lab.number).padStart(2, "0")}</span>
            <strong>{lab.title}</strong>
          </a>
        ))}
      </div>
    </div>
  </aside>

  <main class="content-frame">
    <TopBar />
    <slot />
    <footer class="site-footer">
      <span>Розроблено</span>
      <strong>Tomka Yurii</strong>
      <span>·</span>
      <span>© 2026</span>
      <span class="footer-divider">·</span>
      <div class="share-buttons" aria-label="Поділитись">
        <a class="share-btn" id="share-telegram" href="#" target="_blank" rel="noopener" title="Поділитись у Telegram">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a class="share-btn" id="share-twitter" href="#" target="_blank" rel="noopener" title="Поділитись у Twitter / X">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
        </a>
        <a class="share-btn" id="share-facebook" href="#" target="_blank" rel="noopener" title="Поділитись у Facebook">
          <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      </div>
    </footer>
    <script>
      const url = encodeURIComponent(location.href);
      const text = encodeURIComponent(document.title);
      const tg = document.getElementById("share-telegram");
      const tw = document.getElementById("share-twitter");
      const fb = document.getElementById("share-facebook");
      if (tg) tg.href = `https://t.me/share/url?url=${url}&text=${text}`;
      if (tw) tw.href = `https://twitter.com/intent/tweet?url=${url}&text=${text}`;
      if (fb) fb.href = `https://www.facebook.com/sharer/sharer.php?u=${url}`;
    </script>
  </main>
  <BackToTop />
</div>
