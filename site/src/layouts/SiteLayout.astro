---
import "../styles/global.css";

const {
  title = "OOP C# Course",
  description = "Навчальний курс з ООП на C# / .NET — 22 лабораторні заняття навколо єдиного проєкту медичної клініки.",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL("/author.jpg", Astro.site).toString();
const fullTitle = title === "OOP C# Course" ? title : `${title} | OOP C# Course`;
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Томка Юрій" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OOP C# Course" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="800" />
    <meta property="og:image:height" content="800" />
    <meta property="og:locale" content="uk_UA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%2376c7ad'/><text x='50%25' y='54%25' dominant-baseline='middle' text-anchor='middle' font-family='monospace' font-weight='700' font-size='13' fill='%23151c19'>C%23</text></svg>" />
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      document.documentElement.dataset.theme = savedTheme ?? (prefersDark ? "dark" : "light");
    </script>
    <style>
      .runner-embed { margin: 1.25rem 0; }
      .runner-embed iframe {
        margin: 0 !important;
        border-radius: 8px 8px 0 0 !important;
        display: block;
      }
      .runner-resize-handle {
        height: 10px;
        background: #151c19;
        border: 1px solid #2c3531;
        border-top: none;
        border-radius: 0 0 8px 8px;
        cursor: ns-resize;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 120ms;
      }
      .runner-resize-handle:hover { background: #1c2924; }
      .runner-resize-grip {
        width: 32px;
        height: 3px;
        background: #2c3531;
        border-radius: 2px;
        transition: background 120ms;
      }
      .runner-resize-handle:hover .runner-resize-grip { background: #76c7ad; }
    </style>
    <script is:inline>
      // postMessage: оновлюємо висоту iframe після запуску коду
      window.addEventListener('message', function (e) {
        if (!e.data || e.data.type !== 'runner-height') return;
        var iframes = document.querySelectorAll('iframe');
        for (var i = 0; i < iframes.length; i++) {
          if (iframes[i].contentWindow === e.source) {
            iframes[i].style.height = (e.data.height + 2) + 'px';
            break;
          }
        }
      });

      // Drag-handle знизу кожного runner iframe
      document.addEventListener('DOMContentLoaded', function () {
        var iframes = document.querySelectorAll('iframe[src*="/runner/"]');
        iframes.forEach(function (iframe) {
          var wrapper = document.createElement('div');
          wrapper.className = 'runner-embed';
          iframe.parentNode.insertBefore(wrapper, iframe);
          wrapper.appendChild(iframe);

          var handle = document.createElement('div');
          handle.className = 'runner-resize-handle';
          var grip = document.createElement('div');
          grip.className = 'runner-resize-grip';
          handle.appendChild(grip);
          wrapper.appendChild(handle);

          handle.addEventListener('mousedown', function (e) {
            var startY = e.clientY;
            var startH = iframe.offsetHeight;
            document.body.style.cursor = 'ns-resize';
            document.body.style.userSelect = 'none';
            e.preventDefault();

            function onMove(e) {
              var newH = Math.max(150, startH + (e.clientY - startY));
              iframe.style.height = newH + 'px';
            }
            function onUp() {
              document.body.style.cursor = '';
              document.body.style.userSelect = '';
              document.removeEventListener('mousemove', onMove);
              document.removeEventListener('mouseup', onUp);
            }
            document.addEventListener('mousemove', onMove);
            document.addEventListener('mouseup', onUp);
          });
        });
      });
    </script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
